# Preserve exact CAD, simulation and hash-manifest bytes.
* -text

# Preserve byte-identical manufacturing exports and calibration waveforms.
manufacturing/** -text -whitespace
variants/**/manufacturing/** -text -whitespace
docs/reference/openems/calibration-2026-10-24/** -text
site/audit-data/poc-assembly-*.svg -text -whitespace

# Keep downloaded vendor/reference files and raw solver logs byte-identical.
variants/simulation/**/reference/** -text -whitespace
variants/simulation/power/models/** -text -whitespace
variants/simulation/**/*.log -text -whitespace

# Preserve generated DDR proof vectors, including terminal empty records.
fpga/validation/npu-ddr-4e20-2026-11-07/core-proof-vectors.txt -whitespace
fpga/validation/npu-ddr-4e20-2026-11-07/*.log -whitespace
fpga/validation/npu-ddr-4e21-2026-11-07/*.log -whitespace
fpga/validation/transformer-device-2026-11-07/** -text whitespace=cr-at-eol
fpga/validation/transformer-device-2026-11-07/**/*.f32 binary

# Preserve exact byte streams from DDR and FP32 component qualification.
fpga/validation/npu-ddr-4e22-2026-11-07/** -text -whitespace
fpga/validation/npu-fp32-epilogue-2026-11-07/** -text -whitespace
fpga/validation/npu-fp32-model-trace-2026-11-07/** -text -whitespace
fpga/validation/npu-ddr-4e22-2026-11-07/*.fs binary
fpga/npu/rtl/npu_fp32_epilogue.v whitespace=cr-at-eol
fpga/npu/tests/run_ddr_rx_phase_sweep.py whitespace=cr-at-eol,-blank-at-eof
fpga/npu/tests/run_fp32_epilogue.py whitespace=cr-at-eol
fpga/npu/tests/run_fp32_model_trace.py whitespace=cr-at-eol

# Idle-guard candidate keeps frozen source and raw qualification evidence.
fpga/validation/npu-ddr-4e23-2026-11-07/** -text -whitespace
fpga/validation/npu-ddr-4e23-2026-11-07/*.fs binary
fpga/npu/rtl/npu_ddr_*idle_guard.v whitespace=cr-at-eol
fpga/npu/tests/run_ddr_idle_guard*.py whitespace=cr-at-eol
