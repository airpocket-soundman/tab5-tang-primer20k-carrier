# RAW reply candidate: clock is the actual bus input, not a filtered virtual clock.
# This first build constrains the reply domain to 40MHz (25ns period).
# The SYS request parser is separately exercised at its declared slower TX rates.
# No output-delay/P4-board timing claim is made; board flight/sample phase is not measured.
create_clock -name osc27 -period 37.037037 [get_ports {sys_clk}]
create_generated_clock -name core54 -source [get_ports {sys_clk}] -multiply_by 2 [get_nets {core_clk}]
# The unused sampler216 clock net is swept when filtering is bypassed.
# The preserved PLL lock/reset interlock does not create a data clock domain.
create_clock -name raw_reply40 -period 25.000000 [get_ports {bus_clk}]
report_timing -setup -max_paths 50
report_timing -hold -max_paths 50
report_timing -recovery -max_paths 50
report_timing -removal -max_paths 50
# Bundled-data first stage only: same exact 30 endpoint pairs as the reviewed base.
# All-scenes integration: verify remaining STA and simulation independently.
# EXACT_EXCEPTION_COUNT 30; do not wildcard or exempt metadata_bus.
set_false_path -from [get_pins {core/fast_metadata_10_s0/Q}] -to [get_pins {core/fast_serializer.serializer/metadata_meta_10_s0/D}]
set_false_path -from [get_pins {core/fast_metadata_16_s0/Q}] -to [get_pins {core/fast_serializer.serializer/metadata_meta_16_s0/D}]
